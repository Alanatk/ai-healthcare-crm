# FastAPI configuration
PORT=8000
HOST=127.0.0.1

# Database Connection URL
# SQLite: sqlite:///./crm.db
# MySQL: mysql+pymysql://root:password@localhost:3306/aivoa_crm
# PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/aivoa_crm
DATABASE_URL=sqlite:///./crm.db

# Groq API configuration
# Get your API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# JWT Authentication
JWT_SECRET=super_secret_jwt_sign_key_for_session_token_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
